<Page x:Class="ISIP323_Khachatryan_WPF.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="ФИО:" FontWeight="Bold"/>
            <TextBox x:Name="TbxFullName" Margin="0,5"/>

            <TextBlock Text="Почта (email):" FontWeight="Bold"/>
            <TextBox x:Name="TbxEmail" Margin="0,5"/>

            <TextBlock Text="Адрес доставки:" FontWeight="Bold"/>
            <TextBox x:Name="TbxAddress" Margin="0,5"/>
        </StackPanel>

        <ListBox x:Name="ProductList" 
                 Grid.Row="1" 
                 d:ItemsSource="{d:SampleData ItemCount=3}" 
                 HorizontalContentAlignment="Center" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" >

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Bisque" BorderThickness="1" Margin="10" Padding="10" Width="100">
                        <StackPanel>
                            <Image Source="{Binding ImagePath}" Height="50"/>

                            <TextBlock Text="{Binding Title}" 
                                       FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Height="40"/>

                            <TextBlock Text="{Binding Price, StringFormat='Цена: {0} ₽'}" 
                                       Foreground="Red" FontSize="13" Margin="0,5"/>


                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Background="#F9F9F9">
            <TextBlock x:Name="TxtTotalSum" 
                       Text="Итого к оплате: 0 ₽" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Right" Margin="0,0,0,10"/>
            <Grid>
                <Button Content="Назад"  
                        Click="MainPrevButton_Click"
                        HorizontalAlignment="Left" 
                        Width="100" Height="30"
                        Margin="10"/>

                <Button Content="ЗАКАЗАТЬ" 
                        Click="OrderButton_Click" 
                        HorizontalAlignment="Right" 
                        Width="120" Height="30" 
                        Background="Green" 
                        Foreground="White" FontWeight="Bold"
                        Margin="10"/>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
