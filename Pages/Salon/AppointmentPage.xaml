<Page x:Class="ISIP323_Khachatryan_WPF.Pages.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Запись">

    <Grid>
        <Border BorderBrush="#03567E" BorderThickness="2" CornerRadius="15" Margin="10" Padding="20" Background="#42AAFF" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Width="350">
                <TextBlock x:Name="TxtPageTitle" Text="Оформление записи" Margin="10" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Separator Margin="5" Background="#03567E"/>
                <TextBlock Text="Выбранная услуга:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <TextBlock x:Name="TxtServiceName" Margin="5" TextWrapping="Wrap" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#F0EFEB"/>

                <TextBlock Text="Выберите мастера:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold" Foreground="#ffd700" Margin="5"/>
                <ComboBox x:Name="CbMaster" Margin="5" DisplayMemberPath="FullName" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#03567E" BorderThickness="0"/>

                <TextBlock Text="Выберите дату:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold" Foreground="#ffd700" Margin="5"/>
                <DatePicker x:Name="DpDate" Margin="5" FontFamily="{StaticResource ShS}" Foreground="#03567E" BorderThickness="0" />

                <TextBlock Text="Выберите время:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold" Foreground="#ffd700" Margin="5"/>
                <ComboBox x:Name="CbTime" Margin="5" FontFamily="{StaticResource ShS}" Foreground="#03567E" BorderThickness="0">
                    <TextBlock>10:00</TextBlock>
                    <TextBlock>12:00</TextBlock>
                    <TextBlock>14:00</TextBlock>
                    <TextBlock>16:00</TextBlock>
                    <TextBlock>18:00</TextBlock>
                </ComboBox>

                <TextBlock Text="Способ оплаты:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold" Foreground="#ffd700" Margin="5"/>
                <ComboBox x:Name="CbPayment" Margin="5" FontFamily="{StaticResource ShS}" Foreground="#03567E" BorderThickness="0">
                    <TextBlock>Наличные</TextBlock>
                    <TextBlock>Карта</TextBlock>
                </ComboBox>

                <TextBlock Text="Комментарий:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold" Foreground="#ffd700" Margin="5"/>
                <TextBox x:Name="TbxComment" TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="5" FontFamily="{StaticResource ShS}" BorderThickness="0" Foreground="#03567E"/>

                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="5,10,5,0">
                    <Button x:Name="BtnConfirm" Background="#FFD700" BorderThickness="0" Content="Подтвердить запись" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnConfirm_Click"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
