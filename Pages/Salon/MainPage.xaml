<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Salon.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Salon"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Главная страница">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Поиск:" Margin="5" Background="Transparent" Foreground="#ffd700" FontSize="18" FontFamily="{StaticResource ShS}" VerticalAlignment="Center" />
                    <TextBox x:Name="TbxSearch" Width="150" Height="25" Margin="5" BorderThickness="0" Foreground="#03567E" VerticalAlignment="Center" FontSize="16" TextChanged="FilterChanged"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Категория:" Margin="5" Background="Transparent" Foreground="#ffd700" FontSize="18" FontFamily="{StaticResource ShS}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CbType" Width="150" Height="25" BorderThickness="0" FontSize="16" Foreground="#03567E" Margin="5" VerticalAlignment="Center" FontFamily="{StaticResource ShS}" SelectionChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Мастер:" Margin="5" Background="Transparent" Foreground="#ffd700" FontSize="18" FontFamily="{StaticResource ShS}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CbMaster" Width="286" Height="25" BorderThickness="0" Foreground="#03567E" FontSize="16" Margin="5" VerticalAlignment="Center" FontFamily="{StaticResource ShS}" SelectionChanged="FilterChanged"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="LBServices" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#03567E" BorderThickness="2" Padding="10" Margin="10" CornerRadius="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#F0EFEB"/>
                                <TextBlock Text="{Binding ServiceType.Name}" FontSize="16"  FontFamily="{StaticResource ShS}" Foreground="#F0EFEB"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} руб.}" FontFamily="{StaticResource ShS}" FontSize="18" Foreground="#ffd700" FontWeight="Bold"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="5">
                                <Button Tag="{Binding Id}" x:Name="BtnSelect" Background="#FFD700" BorderThickness="0" Content="Выбрать" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnSelect_Click"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
