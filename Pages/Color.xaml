<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Color"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="2/5">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0"
                        Margin="10">
                <TextBlock Text="Цвет: "
                           Margin="0,10,0,10"
                           FontSize="16"/>

                <ComboBox x:Name="ColorComboBox" SelectionChanged="ColorComboBox_SelectionChanged">
                    <ComboBoxItem Content="Белый (+0 ₽)"/>
                    <ComboBoxItem Content="Черный (+70 000 ₽)"/>
                    <ComboBoxItem Content="Синий (+150 000 ₽)"/>
                    <ComboBoxItem Content="Металический (+75 000 ₽)"/>
                    <ComboBoxItem Content="Серый (+90 000 ₽)"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="10">
                <TextBlock Text="Дополнительные опции: "
                           Margin="0,10,0,10"
                           FontSize="16"/>
                <CheckBox x:Name="LetherCheckBox" Content="Кожаный салон (+200 000 ₽)" Margin="5"/>
                <CheckBox x:Name="HeatedSeatsCheckBox" Content="Подогрев сидений (+30 000 ₽)" Margin="5"/>
                <CheckBox x:Name="SecuritySystemCheckBox" Content="Охранная сигнализация (+30 000 ₽)" Margin="5"/>
                <CheckBox x:Name="MultiMediaCheckBox" Content="Мультимедийные системы (+50 000 ₽)" Margin="5"/>
                <CheckBox x:Name="CameraCheckBox" Content="Парктроники и камеры (+40 000 ₽)" Margin="5"/>
            </StackPanel>
        </Grid>
        
        <StackPanel x:Name="Nav2" 
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="10">
            
            <Button x:Name="NextBtn" 
                    Content="Далее"
                    Padding="5"
                    Margin="0,0,50,0" Click="NextBtn_Click"/>
            <Button x:Name="ShowBtn"
                    Content="Посмотреть выбранные параметры"
                    Padding="5" Click="ShowBtn_Click" />
        </StackPanel>
    </Grid>
</Page>
