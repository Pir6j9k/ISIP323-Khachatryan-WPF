<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Shop.ProductFullInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Shop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Информация о товаре">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent">
        <Border BorderBrush="#03567E" BorderThickness="2" Background="#42AAFF" CornerRadius="15" Padding="30">
            <StackPanel>
                <TextBlock Text="Детали товара" Margin="10" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Separator Margin="5" Background="#03567E"/>
                <TextBlock Text="Наименование:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <TextBlock Text="{Binding Name}" Margin="5" TextWrapping="Wrap" FontSize="16" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#F0EFEB"/>

                <TextBlock Text="Производитель:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <TextBlock Text="{Binding Manufacturer.Name}" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="SemiBold" Foreground="#F0EFEB" Margin="5"/>

                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="Рейтинг:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                    <TextBlock Text="{Binding Rating}" Margin="7" FontFamily="{StaticResource ShS}" FontSize="16" Foreground="#F0EFEB"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Цена:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}" Margin="7" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#F0EFEB"/>
                </StackPanel>
                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" Padding="5" Margin="10,15,10,10">
                    <Button Background="#FFD700" BorderThickness="0" Content="Назад к списку" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnBack_Click"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
