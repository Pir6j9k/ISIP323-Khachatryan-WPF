<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Shop.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Shop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница товаров">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Поиск:" Margin="5" Background="Transparent" FontSize="18" Foreground="#ffd700" FontFamily="{StaticResource ShS}" VerticalAlignment="Center" />
                    <TextBox Width="150" Height="25" x:Name="TbxSearch" Margin="5" FontSize="16" BorderThickness="0" Foreground="#03567E" VerticalAlignment="Center" FontFamily="{StaticResource ShS}" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Тип товара:" Margin="5" Background="Transparent" FontSize="18" Foreground="#ffd700" FontFamily="{StaticResource ShS}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CbProductType" Width="125" Height="25" FontSize="16" BorderThickness="0" Foreground="#03567E" Margin="5" VerticalAlignment="Center" FontFamily="{StaticResource ShS}" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Производитель:" Margin="5" Background="Transparent" FontSize="18" Foreground="#ffd700" FontFamily="{StaticResource ShS}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CBManufacturer" Width="125" Height="25" BorderThickness="0" FontSize="16" Foreground="#03567E" Margin="5" VerticalAlignment="Center" FontFamily="{StaticResource ShS}" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Сортировка:" Margin="5" Background="Transparent" FontSize="18" Foreground="#ffd700" FontFamily="{StaticResource ShS}"/>
                    <ComboBox x:Name="CBSort" Width="125" Height="25" BorderThickness="0" FontSize="16" Foreground="#03567E" Margin="5" SelectionChanged="FilterChanged" FontFamily="{StaticResource ShS}" >
                        <ComboBoxItem Content="По умолчанию"/>
                        <ComboBoxItem Content="Сначала дешевые"/>
                        <ComboBoxItem Content="Сначала дорогие"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Column="4" x:Name="TxtCount" Margin="5" Background="Transparent" FontSize="18" Foreground="#ffd700" FontFamily="{StaticResource ShS}" VerticalAlignment="Center"/>

            </Grid>
        </StackPanel>

        <ListBox x:Name="LBProducts" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=6}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Margin="10" Padding="10" FontFamily="{StaticResource ShS}" MouseDoubleClick="LBoxProducts_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ProductBorder" BorderBrush="#03567E" BorderThickness="2" CornerRadius="15" Margin="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Source="{Binding ImagePath}" Margin="5" Stretch="Uniform"/>

                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#F0EFEB" Margin="5" TextWrapping="Wrap" Width="200" />

                            <TextBlock Grid.Row="2" Text="{Binding ProductType.Name}" Foreground="#F0EFEB" Margin="5"/>

                            <StackPanel Grid.Row="4">
                                <Separator Background="#03567E" Margin="5"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontSize="16" Foreground="#ffd700" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>

                                    <Border x:Name="DiscountLabel" Background="#F0EFEB" CornerRadius="5" Margin="5" Padding="5">
                                        <TextBlock Text="{Binding DiscountPercentage, StringFormat=-{0}%}"  Foreground="#E74C3C" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" VerticalAlignment="Center" Padding="5" Margin="5">
                                    <Button Background="#FFD700" BorderThickness="0" Content="В корзину" Foreground="#03567E"  FontSize="16" FontWeight="Bold" Tag="{Binding}" Click="BtnAddToCart_Click"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHighDiscount}" Value="True">
                            <Setter TargetName="ProductBorder" Property="Background" Value="#E8F5E9"/>
                            <Setter TargetName="ProductBorder" Property="BorderBrush" Value="#C8E6C9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DiscountPercentage}" Value="0">
                            <Setter TargetName="DiscountLabel" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
