<Page x:Class="ISIP323_Khachatryan_WPF.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Заказ">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent">
        <Border BorderBrush="#03567E" BorderThickness="2" Background="#42AAFF" CornerRadius="15" Padding="30">
            <StackPanel>
                <TextBlock Text="Детали заказа" Margin="10" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Separator Margin="5" Background="#03567E"/>
                <TextBlock Text="Выберите день получения:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <DatePicker x:Name="DpDeliveryDate" Margin="5" FontFamily="{StaticResource ShS}" Foreground="#03567E" BorderThickness="0"/>

                <TextBlock Text="Способ оплаты:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <ComboBox x:Name="CmbPayment" Margin="5" FontFamily="{StaticResource ShS}" Foreground="#03567E" BorderThickness="0">
                    <ComboBoxItem Content="Наличными при получении" IsSelected="True"/>
                    <ComboBoxItem Content="Картой при получении"/>
                    <ComboBoxItem Content="СБП (По QR коду)"/>
                </ComboBox>

                <UniformGrid Columns="2">
                    <Button Background="Transparent" Margin="10,15,10,5" BorderThickness="0" Content="Отмена" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnCancel_Click"/>

                    <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" Padding="5" Margin="10,15,10,5">
                        <Button Background="#FFD700" BorderThickness="0" Content="Подтвердить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnConfirm_Click"/>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
