<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Shop.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Shop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="LBCart" Grid.Column="0" Margin="10" Background="Transparent" BorderThickness="0" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" BorderBrush="#03567E" CornerRadius="15" Margin="10" Padding="20">
                        <DockPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10" DockPanel.Dock="Bottom">
                                <Button Content="🗑" Tag="{Binding Product}" x:Name="BtnRemove" Margin="5" Background="Transparent" Foreground="#ffd700" BorderThickness="0" Click="BtnRemove_Click"/>
                                <Button Content="-" Click="BtnMinus_Click" Tag="{Binding Product}" Width="30" Height="30" FontFamily="{StaticResource ShS}" Background="Transparent" FontSize="20" Foreground="#ffd700" FontWeight="Bold" Margin="5" BorderThickness="0"/>
                                <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource ShS}" FontSize="16" Foreground="#F0EFEB" FontWeight="Bold" Margin="5"/>
                                <Button Content="+" Click="BtnPlus_Click" Tag="{Binding Product}" Width="30" Height="30" Background="Transparent" FontFamily="{StaticResource ShS}" FontSize="20" Foreground="#ffd700" FontWeight="Bold" Margin="5" BorderThickness="0"/>
                            </StackPanel>

                            <StackPanel Margin="10" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding Product.Name}" FontSize="18" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#F0EFEB" Margin="5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Product.ProductType.Name}" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#F0EFEB" Margin="5"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Right" Text="{Binding Product.Price, StringFormat={}{0:N0} ₽}" FontFamily="{StaticResource ShS}" FontSize="18" Foreground="#ffd700" FontWeight="Bold" Margin="15" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" CornerRadius="15" BorderBrush="#03567E" BorderThickness="2" Margin="10" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Ваш заказ" Foreground="#FFD700" FontFamily="{StaticResource ShS}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" Margin="5"/>

                <DockPanel Margin="5">
                    <TextBlock Text="Товары:" Foreground="#ffd700" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalCount" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#F0EFEB"/>
                </DockPanel>

                <DockPanel Margin="5">
                    <TextBlock Text="Сумма скидки:" Foreground="#ffd700" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtTotalDiscount" DockPanel.Dock="Right" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#F0EFEB" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>

                <Separator Margin="5" Background="#03567E"/>

                <DockPanel Margin="5">
                    <TextBlock Text="Итого:" FontSize="18" FontWeight="Bold" Foreground="#ffd700" FontFamily="{StaticResource ShS}" />
                    <TextBlock x:Name="TxtFinalPrice" DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Foreground="#F0EFEB" VerticalAlignment="Center"/>
                </DockPanel>

                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" Padding="10" Margin="10">
                    <Button Background="#FFD700" BorderThickness="0" Content="Оформить заказ" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnOrder_Click"/>
                </Border>
            </StackPanel>
        </Border>

    </Grid>
</Page>
