<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Client.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница пользователя">

    <Grid Background="Transparent" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="Transparent" Margin="10" CornerRadius="15" Padding="20" BorderBrush="#03567E" BorderThickness="2">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="60" Height="60" Fill="#ffd700"/>
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUserName" Text="ФИО Пользователя" FontSize="20" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#F0EFEB"/>
                    <TextBlock x:Name="TxtUserPhone" Text="+7 (999) 999-99-99"  FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#F0EFEB"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <GroupBox Header="Мои записи в салон" Grid.Row="1" Margin="10" Padding="5" FontSize="18" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#ffd700" BorderBrush="#03567E">
            <DataGrid x:Name="DgAppointments" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent" Foreground="#03567E">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding AppointmentDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*" />
                    <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}" Width="*"/>
                    <DataGridTextColumn Header="Мастер" Binding="{Binding User1.FullName}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFD700"/>
                        <Setter Property="Foreground" Value="#03567E"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#03567E"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
        </GroupBox>

        <GroupBox Header="Мои заказы товаров" Grid.Row="2" Margin="10" Padding="5" FontSize="18" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#ffd700" BorderBrush="#03567E">
            <DataGrid x:Name="DgOrders" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" Foreground="#03567E" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ Заказа" Binding="{Binding Id}" Width="*"/>
                    <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFD700"/>
                        <Setter Property="Foreground" Value="#03567E"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#03567E"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
        </GroupBox>
    </Grid>
</Page>
