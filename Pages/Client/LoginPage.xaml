<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Client.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Client"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <Border BorderBrush="#03567E" BorderThickness="2" CornerRadius="15" Padding="30" Background="#42AAFF" >
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Вход в систему" Margin="10" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Separator Margin="5" Background="#03567E"/>

                <TextBlock Text="Номер телефона:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <TextBox x:Name="TbxPhone" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontSize="16"  Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <TextBlock Text="Пароль:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <PasswordBox x:Name="PBPassword" Height="25" VerticalContentAlignment="Center" Margin="5" FontFamily="{StaticResource ShS}" FontSize="16" Foreground="#03567E" BorderThickness="0"/>

                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" Padding="5" Margin="10,15,10,5">
                    <Button x:Name="BtnLogin" Background="#FFD700" BorderThickness="0" Content="Войти" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnLogin_Click"/>
                </Border>

                <Button Content="Назад" Margin="15,5,15,5" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Foreground="#03567E" Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
