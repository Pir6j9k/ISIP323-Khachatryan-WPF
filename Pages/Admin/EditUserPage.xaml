<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Admin.EditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Редактирование пользователя">

    <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <Border BorderBrush="#03567E" BorderThickness="2" CornerRadius="15" Margin="10" Padding="20" Background="#42AAFF" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Пользователь" Margin="5" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Separator Margin="5" Background="#03567E"/>
                <TextBlock Text="ФИО / Имя:"  FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5" />
                <TextBox x:Name="TbxName" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontSize="16"  FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <TextBlock Text="Номер телефона:"  FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <TextBox x:Name="TbxLogin" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontSize="16"  FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <TextBlock Text="Пароль:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <TextBox x:Name="TbxPassword" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontSize="16"  FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <TextBlock Text="Роль:"  FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <ComboBox x:Name="CBRole" Height="25"  DisplayMemberPath="Name" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontSize="16"  FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <UniformGrid Columns="2" Margin="10">
                    <Button Content="Отмена" Margin="5" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource ShS}" Foreground="#03567E" FontSize="16" Click="BtnCancel_Click" />

                    <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="5">
                        <Button Background="#FFD700" BorderThickness="0" Content="Сохранить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnSave_Click"/>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
