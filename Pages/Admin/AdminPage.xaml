<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Admin.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница администратора"
       IsVisibleChanged="Page_IsVisibleChanged">

    <Page.Resources>
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Center" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
            <DockPanel>
                <TextBlock Text="Управление пользователем" Margin="5" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>

                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                    <Button Background="#FFD700" BorderThickness="0" Content="+ Добавить пользователя" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnAddUser_Click"/>
                </Border>
            </DockPanel>
        </Border>

        <DataGrid x:Name="DgUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" BorderThickness="0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FFD700"/>
                    <Setter Property="Foreground" Value="#03567E"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    <Setter Property="FontSize" Value="18"/>

                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#03567E"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterText}"/>
                <DataGridTextColumn Header="ФИО/Имя" Binding="{Binding FullName}" Width="*" ElementStyle="{StaticResource Center}"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding Phone}" Width="*" ElementStyle="{StaticResource Center}"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="150" ElementStyle="{StaticResource Center}"/>

                <DataGridTemplateColumn Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Удалить" Width="80" Height="25" Background="Transparent" Foreground="#03567E" FontFamily="{StaticResource ShS}" BorderThickness="0" Click="BtnDeleteUser_Click" Tag="{Binding}"/>
                                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right" Padding="5" Margin="5">
                                    <Button Background="#FFD700" BorderThickness="0" Content="Изменить" Foreground="#03567E" FontFamily="{StaticResource ShS}"  FontWeight="Bold" Click="BtnEditUser_Click" Tag="{Binding}"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
