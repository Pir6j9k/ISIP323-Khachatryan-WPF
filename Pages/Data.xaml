<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Data"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	  xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
	  mc:Ignorable="d" 
	  d:DesignHeight="450" d:DesignWidth="800"
	  Title="5/5">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="auto"/>
            <RowDefinition Height=" auto"/>
            <RowDefinition Height="*"/>
		</Grid.RowDefinitions>
        
		<StackPanel Margin="10"
					Grid.Row="0">

            <TextBlock Text="Введите данные"
					   Grid.Row="0"
					   HorizontalAlignment="Center"
                       FontSize="16"/>
            <!--Имя-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"  
						   Text="Имя: " 
						   Margin="10"/>
                <StackPanel Grid.Column="1" 
							Margin="10">
                    <TextBox x:Name="Name"
                             TextChanged="Name_TextChanged"/>
                </StackPanel>
            </Grid>


            <!--Телефон-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
						   Text="Телефон: " 
						   Margin="10"/>
                <StackPanel Grid.Column="1" 
							Margin="10" >
                    <TextBox x:Name="Phone" 
							 PreviewTextInput="Phone_PreviewTextInput"
                             TextChanged="Name_TextChanged"/>
                </StackPanel>
            </Grid>
            
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"  
					       Text="Почта: " 
					       Margin="10"/>
                <StackPanel Grid.Column="1" 
						    Margin="10">
                    <TextBox x:Name="Email"
                             TextChanged="Name_TextChanged"/>
                </StackPanel>
            </Grid>
        </StackPanel>
		<Button x:Name="FinalBtn"
				Grid.Row="4"
				Grid.ColumnSpan="2"
				HorizontalAlignment="Center"
				VerticalAlignment="Bottom"
				Margin="10"
				Content="Оформить заявку"
				Padding="5" 
                Click="FinalBtn_Click"
                IsEnabled="False"/>
	</Grid>
</Page>
