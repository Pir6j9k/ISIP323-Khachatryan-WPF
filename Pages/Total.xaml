<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Total"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="3/5">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="10">

            <TextBlock Text="Итоговая стоимость" Margin="5" FontSize="16"/>
            <ListBox x:Name="TotalListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Model, StringFormat=Модель: {0}}"/>
                            <TextBlock Text="{Binding Engine, StringFormat= Двигатель: {0}}"/>
                            <TextBlock Text="{Binding Color, StringFormat=Цвет: {0}}"/>
                            <TextBlock Text="{Binding Options}"/>
                            <TextBlock Text="{Binding Price, StringFormat=Стоимость: {0}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        
        <StackPanel x:Name="Nav2" 
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="10">

            <Button x:Name="NextBtn" 
                    Content="Далее"
                    Padding="5"
                    Click="NextBtn_Click"/>

        </StackPanel>
    </Grid>
</Page>
