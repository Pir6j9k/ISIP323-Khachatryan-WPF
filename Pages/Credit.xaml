<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Credit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="4/5">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="10"> 
            <TextBlock Text="Настройка автокредита"
                       Margin="5"
                       HorizontalAlignment="Center"
                       FontSize="16"/>

            <StackPanel Orientation="Horizontal" 
                        Margin="10">
                <TextBlock Text="Первоначальный взнос, %:" 
                           Width="200"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="InitialPercentBox" 
                         Width="80"
                         PreviewTextInput="InitialPercentBox_PreviewTextInput"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" 
                        Margin="10">
                <TextBlock Text="Срок кредита, мес. (12-96):"
                           Width="200" 
                           VerticalAlignment="Center"/>
                <TextBox x:Name="MonthsBox" 
                         Width="80"/>
            </StackPanel>

            <TextBlock x:Name="ResultText"
                       Text="{Binding credit, StringFormat=Сумма кредита: {0}}"
                       Margin="10"/>
            <Button x:Name="CreditBtn" Content="Расcчитать" Width="100" Click="CreditBtn_Click"/>
        </StackPanel>

        <StackPanel x:Name="Nav2" 
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="5">

            <Button x:Name="NextBtn" 
                    Content="Далее"
                    Padding="5"
                    Margin="0,0,50,0" Click="NextBtn_Click"/>
            <Button x:Name="ShowBtn"
                    Content="Посмотреть выбранные параметры"
                    Padding="5" Click="ShowBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
