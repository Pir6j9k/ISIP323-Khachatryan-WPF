<Page x:Class="ISIP323_Khachatryan_WPF.Pages.SavedBuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SavedBuildsPage">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Сохранённые сборки" FontSize="22" FontWeight="Bold" Foreground="Blue" Margin="5"/>


        <Border Grid.Row="1" Grid.Column="0" BorderBrush="DarkBlue" BorderThickness="2" CornerRadius="5" Margin="5" Padding="5">
            <ListView  x:Name="LvSaved" BorderThickness="0" SelectionChanged="SaveBuilds_SelectionChanged" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" Margin="5" Background="White" CornerRadius="5" BorderBrush="DarkBlue" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding name}" FontWeight="Bold" Foreground="Blue" FontSize="14" Padding="5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding author}" Foreground="Blue" FontWeight="Light" Padding="5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Детали сборки" FontSize="22" FontWeight="Bold" Foreground="Blue" Margin="5"/>

        <GroupBox x:Name="GbParts" Grid.Row="1" Grid.Column="1" Margin="5" BorderBrush="DarkBlue" BorderThickness="2" Foreground="Blue" FontSize="14" FontWeight="Bold">
            <ListView x:Name="LvParts" BorderThickness="0" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" Margin="5" Background="White" CornerRadius="5" BorderBrush="DarkBlue" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding name}" Padding="5" FontWeight="Bold" Foreground="Blue"/>
                                <TextBlock Text="{Binding FullDescription}" Padding="5" Foreground="Blue"  FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>
    </Grid>
</Page>
 