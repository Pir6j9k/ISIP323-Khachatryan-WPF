<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Master.MasterPage"
      IsVisibleChanged="Page_IsVisibleChanged"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница мастера">

    <Grid Background="Transparent" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
            <DockPanel>
                <TextBlock Text="График записей на услуги" Margin="5" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                    <Button x:Name="BtnEditServices" Background="#FFD700" BorderThickness="0" Content="Редактировать услуги" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnEditServices_Click"/>
                </Border>
            </DockPanel>
        </Border>

        <DataGrid x:Name="DGridSchedule" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" BorderThickness="0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FFD700"/>
                    <Setter Property="Foreground" Value="#03567E"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    <Setter Property="FontSize" Value="18"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#03567E"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding AppointmentDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="175" ElementStyle="{StaticResource CenterText}"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding User.FullName}" Width="*" ElementStyle="{StaticResource Center}"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}" Width="*" ElementStyle="{StaticResource Center}"/>

                <DataGridTemplateColumn Header="Действия" Width="130" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right" Padding="5" Margin="5">
                                <Button x:Name='BtnDetails' Background="#FFD700" BorderThickness="0" Content="Детали" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnDetails_Click" Tag="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
