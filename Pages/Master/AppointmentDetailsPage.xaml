<Page x:Class="ISIP323_Khachatryan_WPF.Pages.AppointmentDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница записи">

    <Grid Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <Border Background="#42AAFF" CornerRadius="15" BorderBrush="#03567E" BorderThickness="2" Padding="30" >
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Детали записи" Margin="10" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Separator Margin="5" Background="#03567E"/>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Дата и Время:" Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                    <TextBlock x:Name="TxtDateTime" Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource ShS}" FontSize="16" Foreground="#F0EFEB" Margin="7"/>

                    <TextBlock Text="Клиент:" Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                    <TextBlock x:Name="TxtClient" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource ShS}" FontSize="16"  Foreground="#F0EFEB" Margin="7"/>

                    <TextBlock Text="Услуга:" Grid.Row="2" Grid.Column="0" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                    <TextBlock x:Name="TxtService" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource ShS}" FontSize="16"  Foreground="#F0EFEB" Margin="7"/>

                    <TextBlock Text="Статус:"  Grid.Row="3" Grid.Column="0" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                    <TextBlock x:Name="TxtStatus" Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource ShS}" FontSize="16"  Foreground="#F0EFEB" Margin="7"/>

                    <TextBlock Text="Комментарий:" Grid.Row="4" Grid.Column="0" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                    <TextBlock x:Name="TxtComment" Grid.Row="4" Grid.Column="1" FontFamily="{StaticResource ShS}" FontSize="16" TextWrapping="Wrap" FontStyle="Italic" Foreground="#F0EFEB" Margin="7"/>
                </Grid>
                <UniformGrid Columns="2">
                    <Button x:Name="BtnBack" Background="Transparent" Margin="10,15,10,10" BorderThickness="0" Content="Назад к расписанию" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnBack_Click"/>

                    <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" Padding="5" Margin="10,15,10,10">
                        <Button x:Name="BtnComplete" Background="#FFD700" BorderThickness="0" Content="Завершить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnComplete_Click"/>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
