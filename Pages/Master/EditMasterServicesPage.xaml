<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Master.EditMasterServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Master"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница мастера">

    <Grid Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <Border Background="#42AAFF" CornerRadius="15" Padding="30" BorderBrush="#03567E" BorderThickness="2">
            <StackPanel>
                <TextBlock Text="Управление услугами" Margin="10" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Separator Margin="5" Background="#03567E"/>

                <ListBox x:Name="LBoxAllServices" Background="Transparent" BorderThickness="0" Height="200" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" BorderThickness="0"/>
                                <TextBlock Text="{Binding ServiceName}" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#03567E" Margin="5"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" Padding="5" Margin="10,15,10,5">
                    <Button x:Name="BtnSave" Background="#FFD700" BorderThickness="0" Content="Сохранить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnSave_Click"/>
                </Border>

                <Button x:Name="BtnBack" Content="Назад" Margin="15,5,15,10" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource ShS}" FontWeight="Bold" FontSize="16" Foreground="#03567E" Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
