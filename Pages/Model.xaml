<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Model"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="250" d:DesignWidth="500"
      Title="1/5">

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


            
        <StackPanel Grid.Column="0"
                    Grid.Row="0"
                    Margin="10">
            <TextBlock Text="Модель: "
                       Margin="0,10,0,10"
                       FontSize="16"/>
            <ComboBox x:Name="ModelComboBox" SelectionChanged="ModelComboBox_SelectionChanged">
                <ComboBoxItem Content="Toyota Land Cruiser Prado (2 000 000 ₽)"/>
                <ComboBoxItem Content="Toyota Hilux (6 000 000 ₽)"/>
                <ComboBoxItem Content="Mercedes-Benz C-Class (W206) (6 000 000 ₽)"/>
                <ComboBoxItem Content="Mercedes-Benz C-Class Coupe (3 000 000 ₽)"/>
                <ComboBoxItem Content="Mercedes-Benz GLA (5 000 000 ₽)"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Margin="10">
            <TextBlock Text="Двигатель: "
                       Margin="0,10, 0,10"
                       FontSize="16"/>
            
            <ComboBox x:Name="EngineComboBox" SelectionChanged="EngineComboBox_SelectionChanged">
                <ComboBoxItem x:Name="PetrolComboBox" Content="Бензиновый (+175 000 ₽)"/>
                <ComboBoxItem x:Name="DizelComboBox" Content="Дизельный (+500 000 ₽)"/>
                <ComboBoxItem x:Name="ElectroComboBox" Content="Электрический  (+178 000 ₽)"/>
                <ComboBoxItem x:Name="HybridComboBox" Content="Гибридный (+3 000 000 ₽)"/>
            </ComboBox>
        </StackPanel>

        
        <StackPanel x:Name="Nav2" 
                    Grid.Row="1"
                    Grid.ColumnSpan="2 "
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="10">

            <Button x:Name="NextBtn" 
                    Content="Далее"
                    Padding="5"
                    Margin="0,0,50,0" Click="NextBtn_Click"/>
            <Button x:Name="ShowBtn"
                    Content="Посмотреть выбранные параметры"
                    Padding="5" Click="ShowBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
