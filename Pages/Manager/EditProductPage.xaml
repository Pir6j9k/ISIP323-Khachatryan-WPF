<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Manager.EditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="Страница редактирования товара">

    <Grid Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <Border Background="#42AAFF" CornerRadius="15" BorderBrush="#03567E" BorderThickness="2" Padding="30">
            <StackPanel>
                
                <TextBlock x:Name="TxtTitle" Text="Карточка товара" Margin="10" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                <Separator Background="#03567E"/>
                <TextBlock Text="Название" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <TextBox x:Name="TbxName" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <TextBlock Text="Производитель" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <ComboBox x:Name="ComboManuf" DisplayMemberPath="Name" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <TextBlock Text="Тип продукта" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                <ComboBox x:Name="ComboProductType" DisplayMemberPath="Name" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="5">
                        <TextBlock Text="Цена:" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                        <TextBox x:Name="TbxPrice" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Скидка (%):" FontFamily="{StaticResource ShS}" FontSize="18" FontWeight="SemiBold"  Foreground="#ffd700" Margin="5"/>
                        <TextBox x:Name="TbxDiscount" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#03567E" Margin="5" BorderThickness="0"/>
                    </StackPanel>
                </UniformGrid>

                <CheckBox x:Name="CbIsFrozen" BorderThickness="0" Content="Заморозить (снять с продажи)" FontFamily="{StaticResource ShS}" FontWeight="SemiBold" Foreground="#03567E" Margin="5"/>
                <UniformGrid Columns="2" >
                    <Button Background="Transparent" Margin="10,15,10,10" BorderThickness="0" Content="Отмена" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnCancel_Click"/>

                    <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" Padding="5" Margin="10,15,10,10">
                        <Button Background="#FFD700" BorderThickness="0" Content="Сохранить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnSave_Click"/>
                    </Border>

                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
