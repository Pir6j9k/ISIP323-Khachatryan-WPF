<Page x:Class="ISIP323_Khachatryan_WPF.Pages.Manager.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница менеджера"
      IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="Transparent" Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Товары" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#03567E" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
                        <DockPanel>
                            <TextBlock Text="Список товаров" Margin="5" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                <Button Background="#FFD700" BorderThickness="0" Content="+ Добавить товар" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="Button_Click"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DGridProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" BorderThickness="0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterText}"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Center}"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100" ElementStyle="{StaticResource Center}"/>
                            <DataGridCheckBoxColumn Header="Заморозка" Binding="{Binding IsFrozen}" Width="120" />
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Удалить" Width="80" Height="25" Background="Transparent" Foreground="#03567E" BorderThickness="0" Click="BtnDelete_Click" Tag="{Binding}"/>
                                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right" Padding="5" Margin="5">
                                                <Button Background="#FFD700" BorderThickness="0" Content="Изменить" Foreground="#03567E" FontSize="16" FontFamily="{StaticResource ShS}"  FontWeight="Bold" Click="BtnEdit_Click" Tag="{Binding}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Записи" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#03567E" Margin="1" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Поиск клиента:" Margin="5" HorizontalAlignment="Left" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="TbxSearchClient" Width="250" Height="20" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="5" TextChanged="TbxSearchClient_TextChanged"/>
                            </StackPanel>
                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                <Button Background="#FFD700" BorderThickness="0" Content="+ Добавить запись" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnAddAppointment_Click"/>
                            </Border>
                        </DockPanel>
                    </Border>


                    <DataGrid x:Name="DGridAppointments" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" BorderThickness="0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата/Время" Binding="{Binding AppointmentDateTime, StringFormat={}{0:dd.MM HH:mm}}" Width="120" ElementStyle="{StaticResource CenterText}"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding User.FullName}" Width="*" ElementStyle="{StaticResource Center}"/>
                            <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}" Width="*" ElementStyle="{StaticResource Center}"/>
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Отменить" Width="80" Height="25" Background="Transparent" Foreground="#03567E" BorderThickness="0" Click="BtnCancel_Click" Tag="{Binding}"/>
                                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  Padding="5" Margin="5">
                                                <Button Background="#FFD700" BorderThickness="0" Content="Редактировать" Foreground="#03567E" FontSize="16" FontFamily="{StaticResource ShS}" FontWeight="Bold" Click="BtnReschedule_Click" Tag="{Binding}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#03567E" Margin="1" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
                        <TextBlock Text="Список заказов" Margin="5" HorizontalAlignment="Left" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <DataGrid x:Name="DGridOrders" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" BorderThickness="0" HeadersVisibility="Column"  VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterText}"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding User.FullName}" Width="*" ElementStyle="{StaticResource Center}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150" ElementStyle="{StaticResource Center}"/>
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right" Padding="5" Margin="5">
                                            <Button Background="#FFD700" BorderThickness="0" Content="Выдать" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnDeliverOrder_Click" Tag="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Типы услуг" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#03567E" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
                        <DockPanel>
                            <TextBlock Text="Типы услуг" Margin="5" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                <Button Background="#FFD700" BorderThickness="0" Content="+ Добавить тип" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnAddServiceType_Click"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    
                    <DataGrid x:Name="DGridServiceTypes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CellEditEnding="DGridServiceTypes_CellEditEnding" Margin="10" BorderThickness="0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterText}"/>
                            <DataGridTextColumn Header="Название типа" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Center}"/>
                            <DataGridTemplateColumn Header="Действия" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                            <Button Background="#FFD700" BorderThickness="0" Content="Удалить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnDeleteType_Click" Tag="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Типы товаров" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#03567E" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
                        <DockPanel>
                            <TextBlock Text="Типы товаров" Margin="5" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                <Button Background="#FFD700" BorderThickness="0" Content="+ Добавить тип товара" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnAddProductType_Click"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DGridProductTypes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CellEditEnding="DGridProductTypes_CellEditEnding" Margin="10" BorderThickness="0" HeadersVisibility="Column" VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterText}"/>
                            <DataGridTextColumn Header="Название типа товара" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Center}"/>
                            <DataGridTemplateColumn Header="Действия" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                            <Button Background="#FFD700" BorderThickness="0" Content="Удалить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnDeleteProductType_Click" Tag="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Производители" FontSize="16" FontFamily="{StaticResource ShS}" Foreground="#03567E" Margin="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Transparent" CornerRadius="15" Padding="20" Margin="10" BorderBrush="#03567E" BorderThickness="2">
                        <DockPanel>
                            <TextBlock Text="Производители" Margin="5" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="24" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                <Button Background="#FFD700" BorderThickness="0" Content="+ Добавить производителя" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnAddManufacturer_Click"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DGridManufacturers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CellEditEnding="DGridManufacturers_CellEditEnding" Margin="10" BorderThickness="0" HeadersVisibility="Column"  VerticalGridLinesBrush="Transparent" HorizontalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource CenterText}"/>
                            <DataGridTextColumn Header="Производители" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Center}"/>
                            <DataGridTemplateColumn Header="Действия" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" HorizontalAlignment="Right"  DockPanel.Dock="Right" Padding="5" Margin="5">
                                            <Button Background="#FFD700" BorderThickness="0" Content="Удалить" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="16" FontWeight="Bold" Click="BtnDeleteManufacturer_Click" Tag="{Binding}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#03567E"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontFamily" Value="{StaticResource ShS}"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
