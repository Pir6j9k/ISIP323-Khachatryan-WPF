<Window x:Class="ISIP323_Khachatryan_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">


    <Grid Background="#F0EFEB">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/> 
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#03567E" BorderThickness="2" CornerRadius="15" Margin="10" Padding="10" Background="#42AAFF" Width="300">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Косметическая Лажа" Background="Transparent" Foreground="#FFD700" FontFamily="{StaticResource ShS}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Width="200" Margin="10"/>
                    <Separator Grid.Row="1" Background="#03567E"/>

                    <StackPanel Grid.Row="2" VerticalAlignment="Top">
                        <Button Tag="Main" Background="#42AAFF" BorderThickness="0" Content="Главная" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" Click="Navigating" />
                        <Button Tag="Shop" Background="#42AAFF" BorderThickness="0" Content="Магазин" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" Click="Navigating" />
                        <Button x:Name="BtnCart" Tag="Cart" Background="#42AAFF" BorderThickness="0" Content="Корзина" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" Click="Navigating" Visibility="Collapsed" />
                        <Button x:Name="BtnMyRecords" Tag="Account" Background="#42AAFF" BorderThickness="0" Content="Мой кабинет" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" Click="Navigating" Visibility="Collapsed"/>
                        <Button x:Name="BtnMasterRecords" Tag="Master" Background="#42AAFF" BorderThickness="0" Content="Мои смены" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" Click="Navigating" Visibility="Collapsed" />
                        <Button x:Name="BtnManagerPanel" Tag="Manager" Background="#42AAFF" BorderThickness="0" Content="Управление салоном" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" Click="Navigating" Visibility="Collapsed"/>
                        <Button x:Name="BtnAdminPanel" Tag="Admin" Background="#42AAFF" BorderThickness="0" Content="Пользователи" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" Click="Navigating" Visibility="Collapsed"/>
                    </StackPanel>

                    <Separator Grid.Row="3" Background="#03567E" VerticalAlignment="Bottom"/>

                    <StackPanel Grid.Row="4">
                        
                        <TextBlock x:Name="TxtCurrentUser" Text="Вы вошли как: Гость" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtUserRole" Foreground="#ffd700" FontFamily="{StaticResource ShS}" Margin="5" Padding="5" FontSize="20" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <Border Grid.Row="5"  Background="#ffd700" BorderBrush="#ffd700" BorderThickness="0" CornerRadius="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="10" Margin="5">
                        <Button x:Name="BtnLogin" Background="#FFD700" BorderThickness="0" Content="Войти в аккаунт" Foreground="#03567E" FontFamily="{StaticResource ShS}" FontSize="20" FontWeight="Bold" Click="BtnLogin_Click"/>
                    </Border>

                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1" BorderBrush="#03567E" BorderThickness="2" CornerRadius="15" Margin="10" Padding="10" Background="#42AAFF">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button x:Name="BtnBack" Content="☚" Background="#42AAFF" BorderThickness="0" Visibility="Hidden" Margin="10" Padding="5" HorizontalAlignment="Left" FontSize="26" Foreground="#ffd700"  Click="GoBack_Click" />
                        <TextBlock x:Name="TxtPageTitle" Text="Главная страница" Margin="10" HorizontalAlignment="Center" FontFamily="{StaticResource ShS}" FontWeight="Bold" Foreground="#ffd700" FontSize="26" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Grid.Row="1" Background="#03567E"/>
                    <Frame x:Name="MainFrame" Grid.Row="2" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated" ScrollViewer.VerticalScrollBarVisibility="Visible" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
