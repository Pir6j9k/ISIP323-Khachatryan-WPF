<Application x:Class="ISIP323_Khachatryan_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ISIP323_Khachatryan_WPF"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="SS">
            ./Fonts/SofiaSans-Regular.ttf#Sofia Sans
        </FontFamily>
        <FontFamily x:Key="ShS">
            ./Fonts/ShantellSans-Regular.ttf#Shantell Sans
        </FontFamily>
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Center" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
